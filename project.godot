[gd_project]

config_version=5

[application]

config/name="Echoes of Mu"
config/version="0.1.0"
run/main_scene="res://src/scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

GameState="*res://src/autoload/game_state.gd"
Audio="*res://src/autoload/audio.gd"
Dialogue="*res://src/autoload/dialogue.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_argument=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.06, 1)
