 "objects": {
  "a": {
   "kind": "chest",
   "id": "v_chest3",
   "text": "A reliquary kept for three ringers who never came back together. Inside lies a plain brass bell-pull, and a note: 'Seal the seals in the right hands.' The hands were right. It rings once, in thanks.",
   "item": "Ringers' Reliquary Bell-Pull",
   "reward": "relic",
   "empty": "You've already searched here."
  },
  "d": {
   "kind": "urn",
   "id": "v_urn1",
   "text": "Behind a cracked urn, a tarnished Ringer's Token stamped with seven small bells. Someone left it here for luck.",
   "item": "Ringer's Token",
   "reward": "relic",
   "empty": "You've already searched here."
  },
  "e": {
   "kind": "crate",
   "id": "v_crate",
   "text": "A rotted crate of altar candles, and under them a Brass Plumb-Bob, still swinging, though there is no draught.",
   "item": "Brass Plumb-Bob",
   "reward": "relic",
   "empty": "You've already searched here."
  },
  "f": {
   "kind": "barrel",
   "id": "v_barrel",
   "text": "A cask of ancient small beer. It should be vinegar by now. It tastes of bread and rain, and you feel restored.",
   "item": "Old Small Beer",
   "reward": "heal",
   "empty": "You've already searched here."
  },
  "h": {
   "kind": "tomes",
   "id": "v_tomes",
   "text": "A Ringers' Ledger. Seven names, one struck through, and a margin note in blue ink: 'He went down to tune the sixth. He is still tuning.'",
   "item": "Ringers' Ledger",
   "reward": "relic",
   "empty": "You've already searched here."
  },
  "i": {
   "kind": "chest",
   "id": "v_chest1",
   "text": "The chest holds a glass bead the size of a walnut, full of slow red light. It pulses against your palm in time with your bell. Your vitality grows.",
   "item": "Heart of the Cistern",
   "reward": "maxhp",
   "empty": "You've already searched here."
  },
  "j": {
   "kind": "grave",
   "id": "v_grave1",
   "text": "BAELLE WYND, Ringer of the First Bell. 'She taught the dark its key.' The stone is warm.",
   "reward": "lore",
   "empty": "You've already searched here."
  },
  "k": {
   "kind": "grave",
   "id": "v_grave2",
   "text": "TOBIAS KERR, Ringer of the Third Bell. 'He rang until his hands forgot him.' Fresh wax has been dripped at the foot of the slab.",
   "reward": "lore",
   "empty": "You've already searched here."
  },
  "m": {
   "kind": "grave",
   "id": "v_grave3",
   "text": "The slab bears no name, only a small blue thread knotted through the carved bell. It is still tight.",
   "reward": "lore",
   "empty": "You've already searched here."
  },
  "n": {
