 "objects": {
  "a": {
   "kind": "grave",
   "id": "e_grave1",
   "text": "Here lies Agnes Thorn, bell-founder's widow. 'She rang once and the town remembered.' Moss has crept over the last word.",
   "reward": "lore",
   "empty": "You've already searched here."
  },
  "d": {
   "kind": "grave",
   "id": "e_grave2",
   "text": "Hugh Lennox, 1590-1644. 'He mended what others only measured.' A tiny bell is carved at the foot of the stone.",
   "reward": "lore",
   "empty": "You've already searched here."
  },
  "e": {
   "kind": "grave",
   "id": "e_grave3",
   "text": "The stone is smooth. No name, no date. A fresh posy lies at its foot, though nobody remembers whose it is.",
   "reward": "lore",
   "empty": "You've already searched here."
  },
  "f": {
   "kind": "statue",
   "id": "e_statue",
   "text": "A bronze founder, a bell cradled in her arms. 'MARGARET THE CASTER: She taught the town to speak with one voice.' The bell's lip is worn bright by a thousand hands.",
   "reward": "lore",
   "empty": "You've already searched here."
  },
  "h": {
   "kind": "urn",
   "id": "e_urn",
   "text": "Behind the urn, wrapped in oilcloth: a Silver Bell Pin. Rab was right.",
   "item": "Silver Bell Pin",
   "reward": "relic",
   "empty": "You've already searched here."
  },
  "i": {
   "kind": "grave",
   "empty": "You've already searched here."
  },
  "j": {
   "kind": "chest",
   "id": "e_chest",
   "text": "The chest is crammed into a crack of the Close. Inside, wrapped in a child's mitten: a small red stone that beats like a heart. Your vitality grows.",
   "item": "Heart of the Old Town",
   "reward": "maxhp",
   "empty": "You've already searched here."
  },
  "k": {
   "kind": "barrel",
   "id": "e_barrel",
